{
  "version": 3,
  "note": "Canonical controlled vocabulary for labelling the emoji catalog. Every tag applied to an emoji must be an id from this file. `aliases` are the free-text tags from the legacy catalog that fold into each id — they exist to migrate old data and to seed few-shot examples, not to be applied as labels. An alias may appear under two tags in DIFFERENT facets (a knife emoji is both subject:object and prop:weapon-prop); two tags in the SAME facet must never share one.",
  "facets": {
    "subject": {
      "label": "Subject",
      "cardinality": "1-2",
      "required": true,
      "note": "What the picture is of. The single most useful handle; keep it literal."
    },
    "expression": {
      "label": "Expression",
      "cardinality": "0-4",
      "required": false,
      "note": "The feeling the face or body is showing. Skip when there is no face. Up to four — the blob faces routinely stack anxious + embarrassed + disgusted."
    },
    "action": {
      "label": "Action",
      "cardinality": "0-2",
      "required": false,
      "note": "What the subject is visibly doing."
    },
    "intent": {
      "label": "Intent",
      "cardinality": "1-3",
      "required": true,
      "note": "What you would be saying by posting this in a channel. Rarely present in the source art — this is the facet the labeller has to reason about, and the one most searches are really asking for."
    },
    "prop": {
      "label": "Prop",
      "cardinality": "0-3",
      "required": false,
      "note": "Objects, clothing and visual devices present alongside the subject."
    },
    "style": {
      "label": "Style",
      "cardinality": "1-2",
      "required": true,
      "note": "How it is drawn or rendered, independent of what it depicts."
    },
    "color": {
      "label": "Color",
      "cardinality": "1-2",
      "required": true,
      "note": "Dominant colors only — the one or two a person would name from across the room."
    },
    "origin": {
      "label": "Origin",
      "cardinality": "0-2",
      "required": false,
      "note": "A named franchise, meme or person. Apply only when a viewer would recognise the source; never guess. Two are allowed when a frame genuinely carries both, e.g. a franchise character plus a brand logo."
    }
  },
