---
import { ThemeToggle } from "../components/theme-toggle";
import "../styles/globals.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Emoji Explorer: Search, share, & export emojis with ease"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
    <script is:inline>
      const pagefindOptions = {
        excerptLength: 50,
        baseUrl: "/",
        highlightParam: "highlight",
      };

      import("/pagefind/pagefind.js")
        .then((module) => {
          console.log("Pagefind loaded:", module);
          const pagefind = module;
          window.pagefind = pagefind;
          pagefind
            .init(pagefindOptions)
            .then(() => {
              console.log("Pagefind initialized");
              // pagefind.search('emoji');
            })
            .catch((error) => {
              console.error("Error initializing Pagefind:", error);
            });
        })
        .catch((error) => {
          console.error("Error loading Pagefind:", error);
        });
    </script>

  </head>
  <body>
    <div class="min-h-screen bg-background text-foreground">
      <header class="app-header container mx-auto">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="brand-mark" aria-hidden="true">✳︎</span>
            <div>
              <p class="brand-eyebrow">A little more expressive</p>
              <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Emoji Explorer</h1>
            </div>
          </div>
          <ThemeToggle client:load />
        </div>
        <div class="header-details">
          <p class="text-sm text-muted-foreground">Find your next reaction. Pick your favorites. Make Slack yours.</p>
          <nav class="engagement-links" aria-label="Support the creator">
            <a class="engagement-link" href="https://github.com/justsml/emoji-brain" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.4c0-1 .1-1.5-.5-2.1 3.3-.4 6.8-1.6 6.8-7.3a5.7 5.7 0 0 0-1.5-4 5.3 5.3 0 0 0-.1-4s-1.3-.4-4.2 1.5a14.3 14.3 0 0 0-7.6 0C5 .1 3.7.5 3.7.5a5.3 5.3 0 0 0-.1 4 5.7 5.7 0 0 0-1.5 4c0 5.7 3.5 6.9 6.8 7.3-.5.5-.6 1-.6 2.1v3.4" transform="translate(1 1) scale(.9)" /></svg>
              View on GitHub
            </a>
            <a class="engagement-link engagement-link-thanks" href="https://twitter.com/intent/tweet?text=Thanks%20%40justsml%20for%20Emoji%20Explorer%21&url=https%3A%2F%2Fgithub.com%2Fjustsml%2Femoji-brain" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" /></svg>
              Thank @justsml
            </a>
            <a class="engagement-link" href="https://danlevy.net" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
              danlevy.net
            </a>
          </nav>
        </div>
      </header>
      <main class="w-full">
        <slot />
      </main>
      <div id="error-boundary-root" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    </div>
  </body>
</html>
