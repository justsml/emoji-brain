---
import "../styles/fonts.css";
import "../styles/globals.css";
import emojiMetadata from "../data/emoji-metadata.json";
import { animatedSrcSet } from "../lib/emojiAssets";
import { DEFAULT_GRID_SCALE, GRID_SCALE_STORAGE_KEY, LIGHT_STICKER_SIZE, STICKER_SIZES } from "../lib/gridScales";
import { PREVIEW_QUALITY_KEY, REMEMBER_SLOW_MS, SLOW_PAGE_MS, SLOW_SEEN_KEY } from "../lib/previewQuality";

interface Props {
  title: string;
  imageCount: number;
  discovery?: boolean;
  description: string;
  noindex?: boolean;
  heading?: string;
  structuredData?: Record<string, unknown>[];
}

const { title, description, imageCount, discovery = false, noindex = false,
  heading = "Adorbs.fun", structuredData = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site!).href;
const socialImage = new URL("/social-card.png", Astro.site!).href;
const websiteId = new URL("/#website", Astro.site!).href;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    ...(Astro.url.pathname === "/" ? [{
      "@type": "WebSite", "@id": websiteId,
      name: "Adorbs.fun", alternateName: "Adorbs", url: Astro.site!.href,
      description, inLanguage: "en",
    }] : []),
    { "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical,
      name: title, description, inLanguage: "en", isPartOf: { "@id": websiteId } },
    ...structuredData,
  ],
};
const schemaJson = JSON.stringify(schema).replace(/</g, "\\u003c");
const emojisLastAdded = emojiMetadata.emojis.reduce(
  (latest, emoji) => emoji.created > latest ? emoji.created : latest, "",
);
const emojiUpdateDate = emojisLastAdded && new Intl.DateTimeFormat("en-US", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
}).format(new Date(emojisLastAdded));

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Adorbs.fun" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Adorbs.fun — cute custom emojis and stickers for Slack" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Adorbs.fun — cute custom emojis and stickers for Slack" />
    <script type="application/ld+json" is:inline set:html={schemaJson} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline define:vars={{ stickerSizes: STICKER_SIZES, defaultScale: DEFAULT_GRID_SCALE, scaleKey: GRID_SCALE_STORAGE_KEY, lightSize: LIGHT_STICKER_SIZE, qualityKey: PREVIEW_QUALITY_KEY, slowSeenKey: SLOW_SEEN_KEY, rememberSlowMs: REMEMBER_SLOW_MS, slowPageMs: SLOW_PAGE_MS }}>
      // Placeholders hide once their sticker has painted. This runs before the
      // body parses and long before the island hydrates, which on a slow link
      // can be the last thing to arrive. `load` doesn't bubble, so capture it.
      // The timestamp feeds the blank-screen check (useSlowConnectionWatch).
      document.documentElement.classList.add("ph-js");
      document.addEventListener("load", (event) => {
        const image = event.target;
        if (!(image instanceof HTMLImageElement) || !image.classList.contains("emoji-card-image")) return;
        image.dataset.ready = "";
        window.emojiReadyAt = performance.now();
      }, true);
      // A background tab is throttled; its timings say nothing about the network.
      window.emojiHiddenSeen = document.visibilityState === "hidden";
      document.addEventListener("visibilitychange", () => { if (document.hidden) window.emojiHiddenSeen = true; });
      // The server renders the grid at the default size, for a fast
      // connection; the island only applies a stored size or light previews
      // (src/lib/previewQuality.ts) once it hydrates, and Chrome never trades
      // a larger image it already has for a smaller one. So correct `sizes` as
      // each sticker is parsed, before a lazy image has fetched anything.
      const read = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
      const stored = read(qualityKey);
      const lightPreviews = stored ? stored === "light" : (() => {
        const connection = navigator.connection;
        if (connection && (connection.saveData || connection.effectiveType === "2g" || connection.effectiveType === "slow-2g")) return true;
        return Date.now() - Number(read(slowSeenKey)) < rememberSlowMs;
      })();
      const storedScale = read(scaleKey);
      const slot = lightPreviews ? lightSize
        : (storedScale === null ? undefined : stickerSizes[Number(storedScale)]) ?? stickerSizes[defaultScale];
      const observer = new MutationObserver((records) => {
        // Stickers still being parsed this late mean the HTML itself is
        // crawling in: give the rest of the sheet light previews already.
        const late = !stored && !window.emojiHiddenSeen && performance.now() > slowPageMs;
        const size = late ? lightSize : slot;
        if (size === stickerSizes[defaultScale]) return;
        for (const record of records) for (const node of record.addedNodes) {
          if (!(node instanceof HTMLImageElement) || !node.classList.contains("emoji-card-image") || !node.srcset) continue;
          if (size !== lightSize) { node.sizes = `${size}px`; continue; }
          // Light previews take the smallest file at any density; once the
          // island hydrates, its upgrade queue sharpens them in the background.
          node.removeAttribute("srcset");
          node.removeAttribute("sizes");
          node.src = node.src.replace(/\/previews\/\d+\//, `/previews/${lightSize}/`);
        }
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });
      document.addEventListener("DOMContentLoaded", () => observer.disconnect(), { once: true });
    </script>
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>


  </head>
  <body>
    <div class="page-shell">
      <header class="app-header">
        <nav class="utility-rail" aria-label="Project links">
          <a class="rail-link" href="https://github.com/justsml/emoji-brain" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.4c0-1 .1-1.5-.5-2.1 3.3-.4 6.8-1.6 6.8-7.3a5.7 5.7 0 0 0-1.5-4 5.3 5.3 0 0 0-.1-4s-1.3-.4-4.2 1.5a14.3 14.3 0 0 0-7.6 0C5 .1 3.7.5 3.7.5a5.3 5.3 0 0 0-.1 4 5.7 5.7 0 0 0-1.5 4c0 5.7 3.5 6.9 6.8 7.3-.5.5-.6 1-.6 2.1v3.4" transform="translate(1 1) scale(.9)" /></svg>
            <span>Source</span>
          </a>
          <a class="rail-link rail-link-thanks" href="https://twitter.com/intent/tweet?text=Thanks%20%40justsml%20for%20Adorbs.fun%21&url=https%3A%2F%2Fadorbs.fun%2F" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" /></svg>
            <span>Thank @justsml</span>
          </a>
          <a class="rail-link" href="https://danlevy.net" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            <span>danlevy.net</span>
          </a>
          <a class="rail-link" href="/slack-backup">Back up Slack emojis</a>
          {/* Plain markup and a few lines of script: a React island here would
              hydrate a second root and pull the renderer in just for one click. */}
          <button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 hover:bg-accent h-8 w-8 text-muted-foreground hover:text-foreground" aria-label="Switch to dark theme"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon absolute h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg></button>
          <script is:inline>
            (() => {
              const button = document.currentScript.previousElementSibling, root = document.documentElement;
              const label = () => button.setAttribute("aria-label", `Switch to ${root.classList.contains("dark") ? "light" : "dark"} theme`);
              label();
              button.addEventListener("click", () => {
                const dark = !root.classList.contains("dark");
                root.classList.toggle("dark", dark);
                try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
                label();
              });
            })();
          </script>
        </nav>

        <div class="masthead">
          <div class="masthead-copy">
            <h1 class="masthead-title">
              <img class="brand-mark" src="/emoji-delivery/64/meow_birthday.webp" srcset={animatedSrcSet("meow_birthday.webp")} sizes="42px" alt="" aria-hidden="true" width="42" height="42" />
              <a href="/">{heading}</a>
            </h1>
            <p class="masthead-lede">
              A hand-collected sheet of <b>{imageCount.toLocaleString("en-US")} stickers</b>. Pick the ones you want,
              then paste a single script into Slack to upload the lot.
            </p>
          </div>
          {discovery && <div id="catalog-discovery" class="catalog-discovery-slot"><span class="atlas-placeholder">Explore by theme &amp; color</span></div>}
          <slot name="masthead-note" />
        </div>
      </header>
      <main class="w-full">
        <slot />
      </main>
      <footer class="colophon">
        {emojisLastAdded && <p class="collection-updated">
          Emojis last updated: <time datetime={emojisLastAdded}>{emojiUpdateDate}</time>
        </p>}
        <p>
          Missing something? <a href="https://github.com/justsml/emoji-brain/issues/new?title=Emoji%20suggestion" target="_blank" rel="noopener noreferrer">Suggest an emoji on GitHub</a> — the collection grows by request.
        </p>
        <p>
          Adorbs.fun is an educational project exploring web performance with dense visual lists.
        </p>
        <p>
          The artwork here was collected from around the internet and stays the property of whoever
          drew it. Characters, logos and trademarks belong to their respective owners, and appear
          here for identification only. This project is not affiliated with, sponsored by, or
          endorsed by Slack. If something of yours shouldn’t be here, <a href="https://github.com/justsml/emoji-brain/issues/new?title=Removal%20request" target="_blank" rel="noopener noreferrer">open an issue</a> and it comes down.
        </p>
      </footer>
      <div id="error-boundary-root" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    </div>
  </body>
</html>
