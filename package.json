{
  "name": "emoji-brain",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --port ${PORT:-3000}",
    "build": "bun scripts/create-pagefind-index.ts && astro build",
    "preview": "astro preview --port ${PORT:-4321}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "check-emojis": "bun scripts/check-emojis.ts",
    "update-emojis": "bun scripts/update-emojis.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.64",
    "@astrojs/react": "^6.0.5",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "ai": "^7.0.93",
    "astro": "^7.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dedent": "^0.7.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.0",
    "dedent": "^1.7.2",
    "jsdom": "^30.0.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
