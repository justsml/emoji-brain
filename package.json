{
  "name": "emoji-brain",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --port ${PORT:-3000}",
    "build": "bun scripts/create-pagefind-index.ts && astro build",
    "check:seo": "node scripts/check-seo.mjs",
    "preview": "astro preview --port ${PORT:-4321}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "check-emojis": "bun scripts/check-emojis.ts",
    "update-emojis": "bun scripts/update-emojis.ts",
    "generate:emoji-delivery": "node scripts/generate-emoji-delivery-batches.mjs",
    "check:emoji-delivery": "node scripts/validate-emoji-delivery.mjs",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts",
    "process-similarity": "bun scripts/process-similarity.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.88",
    "@astrojs/react": "^7.0.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "ai": "^7.0.128",
    "astro": "^7.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "posthog-js": "^1.438.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dedent": "^0.7.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.3",
    "dedent": "^1.7.2",
    "jsdom": "^30.1.2",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.21.0"
}
